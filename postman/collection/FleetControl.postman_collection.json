                  "var orderId = pm.environment.get('orderId');",
                  "if (!orderId) {",
                  "    throw new Error('orders/start: orderId missing — run maintenance/orders/list first (needs PENDING orders in DB; if none, truncate maintenance_orders and restart ms-maintenance to re-seed)');",
                  "}"
