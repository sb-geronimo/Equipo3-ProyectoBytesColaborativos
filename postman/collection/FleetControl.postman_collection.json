          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('registerEmail') || !pm.environment.get('registerPassword')) {",
                  "    throw new Error('login requires registerUsername/registerEmail/registerPassword in env; run auth/register first');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login status 200', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "var body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "if (pm.response.code === 200 && body && body.token) {",
                  "    pm.environment.set('token', body.token);",
                  "    if (body.userId) { pm.environment.set('userId', body.userId); }",
                  "}",
                  "pm.test('captured token is a JWT', function () {",
                  "    pm.expect(pm.environment.get('token') || '').to.match(/^eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\./);",
