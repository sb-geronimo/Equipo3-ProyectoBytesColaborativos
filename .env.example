# credenciales de la instancia unica de PostgreSQL
POSTGRES_USER=fleet
POSTGRES_PASSWORD=colocar_password_db

# valores para JWT
# jwt secret: debe tener al menos 32 caracteres, creado desde bash con: openssl rand -base64 32
# jwt expiration: tiempo en milisegundos (Ejem: 1 hora = 3600000 ms)
JWT_SECRET=aqui_colocar_la_clave_secreta_puede_crearse_con_openssl_desde_bash
JWT_EXPIRATION=3600000

# clave interna compartida por las llamadas entre microservicios (cabecera X-Internal-Key)
INTERNAL_API_KEY=aqui_colocar_la_clave_interna

# generador de datos de demostracion (perfil demo)
SPRING_PROFILES_ACTIVE=demo
DEMO_SEED=42
DEMO_DAYS=90
DEMO_ADMIN_PASSWORD=Cambia_Admin123

# rate limiting del gateway: peticiones maximas por minuto e IP (429 al superarlo)
RATE_LIMIT_PER_MINUTE=60